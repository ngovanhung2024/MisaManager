<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <TargetName>MisaManager</TargetName>
    <Platform>x64</Platform>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.1.0</PackageVersion>
    <PublishRoot Condition="'$(PublishRoot)' == ''">$(MSBuildThisFileDirectory)..\out\publish\staged</PublishRoot>
    <DefineConstants>PublishRoot=$(PublishRoot);AppRoot=$(PublishRoot)\app;BridgeRoot=$(PublishRoot)\bridge;NoticeRoot=$(PublishRoot)\notices;PackageVersion=$(PackageVersion)</DefineConstants>
    <HarvestDirectoryAutogenerateGuids>true</HarvestDirectoryAutogenerateGuids>
    <HarvestDirectoryGenerateGuidsNow>false</HarvestDirectoryGenerateGuidsNow>
    <!-- ICE91 is a known per-user diagnostic: this package intentionally installs only under LocalAppData. -->
    <SuppressIces>ICE91</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="4.0.6" />
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.6" />
  </ItemGroup>
  <ItemGroup>
    <HarvestDirectory Include="$(PublishRoot)\app">
      <ComponentGroupName>AppFiles</ComponentGroupName>
      <DirectoryRefId>APPFOLDER</DirectoryRefId>
      <PreprocessorVariable>AppRoot</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressRegistry>true</SuppressRegistry>
      <Transforms>$(MSBuildThisFileDirectory)HeatPerUser.xsl</Transforms>
    </HarvestDirectory>
    <HarvestDirectory Include="$(PublishRoot)\bridge">
      <ComponentGroupName>BridgeFiles</ComponentGroupName>
      <DirectoryRefId>BRIDGEFOLDER</DirectoryRefId>
      <PreprocessorVariable>BridgeRoot</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressRegistry>true</SuppressRegistry>
      <Transforms>$(MSBuildThisFileDirectory)HeatPerUser.xsl</Transforms>
    </HarvestDirectory>
    <HarvestDirectory Include="$(PublishRoot)\notices">
      <ComponentGroupName>NoticeFiles</ComponentGroupName>
      <DirectoryRefId>NOTICESFOLDER</DirectoryRefId>
      <PreprocessorVariable>NoticeRoot</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressRegistry>true</SuppressRegistry>
      <Transforms>$(MSBuildThisFileDirectory)HeatPerUser.xsl</Transforms>
    </HarvestDirectory>
  </ItemGroup>
  <Import Project="StableComponentGuids.targets" />
</Project>
