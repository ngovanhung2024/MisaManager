<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="MISA Excel Manager" Manufacturer="MisaManager" Version="$(var.PackageVersion)"
           UpgradeCode="A4A72B74-3D7F-4D42-A81E-3A2E69C7E5B3" Scope="perUser">
    <SummaryInformation Description="Native MISA Excel Manager" />
    <MajorUpgrade DowngradeErrorMessage="A newer MISA Excel Manager is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="USERPROGRAMSFOLDER" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="MisaManager">
          <Directory Id="APPFOLDER" Name="app" />
          <Directory Id="NOTICESFOLDER" Name="notices" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <!-- Start menu and desktop shortcuts: the app is launched like any installed program, no script needed.
         Non-advertised shortcuts in a per-user package need an HKCU keypath (ICE38/ICE43). -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="B9CAA8C7-2A96-5580-9A1C-F4D2C924F4CE">
        <Shortcut Id="StartMenuShortcut" Name="MISA Excel Manager" Description="Import Excel invoices into MISA"
                  Target="[APPFOLDER]MisaManager.App.exe" WorkingDirectory="APPFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\MisaManager\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="54E12BFE-C4CF-5B32-81F1-26F0D346DBDB">
        <Shortcut Id="DesktopShortcut" Name="MISA Excel Manager" Description="Import Excel invoices into MISA"
                  Target="[APPFOLDER]MisaManager.App.exe" WorkingDirectory="APPFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\MisaManager\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="MainFeature" Title="MISA Excel Manager" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="NoticeFiles" />
      <ComponentGroupRef Id="FolderCleanup" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
    <ComponentGroup Id="FolderCleanup">
      <ComponentRef Id="InstallFolderCleanup" />
      <ComponentRef Id="AppFolderCleanup" />
      <ComponentRef Id="NoticesFolderCleanup" />
    </ComponentGroup>
    <Component Id="InstallFolderCleanup" Directory="INSTALLFOLDER" Guid="7C0D2506-0D8A-49F5-9A54-5F9C2C3AE9D7">
      <RegistryValue Root="HKCU" Key="Software\MisaManager\Folders" Name="Install" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <RemoveFolder Id="RemoveUserProgramsFolder" Directory="USERPROGRAMSFOLDER" On="uninstall" />
    </Component>
    <Component Id="AppFolderCleanup" Directory="APPFOLDER" Guid="A8A5F4D9-C9B2-4BE8-9B64-3E4D2BFC5F8A">
      <RegistryValue Root="HKCU" Key="Software\MisaManager\Folders" Name="App" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoveAppFolder" On="uninstall" />
    </Component>
    <Component Id="NoticesFolderCleanup" Directory="NOTICESFOLDER" Guid="5AEFE6D3-EA6C-41A0-86F4-4A6E6A0A9D48">
      <RegistryValue Root="HKCU" Key="Software\MisaManager\Folders" Name="Notices" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoveNoticesFolder" On="uninstall" />
    </Component>
    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
