<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure logic tests: no MISA, no UI. Runs on Windows and (with EnableWindowsTargeting) on Linux. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MisaManager.Core/MisaManager.Core.csproj" />
    <ProjectReference Include="../../src/MisaManager.Import/MisaManager.Import.csproj" />
  </ItemGroup>
</Project>
