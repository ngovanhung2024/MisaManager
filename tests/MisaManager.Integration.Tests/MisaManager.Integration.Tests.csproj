<Project Sdk="Microsoft.NET.Sdk">
  <!-- Drives the fake MISA R20 (tests/MisaManager.FakeMisa) with the real automation stack.
       UI tests run only on Windows with MISAMANAGER_UI_TESTS=1; elsewhere they are skipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MisaManager.Core/MisaManager.Core.csproj" />
    <ProjectReference Include="../../src/MisaManager.Automation/MisaManager.Automation.csproj" />
    <!-- Build order only: the fake runs as its own process (MISA.SME.exe). -->
    <ProjectReference Include="../MisaManager.FakeMisa/MisaManager.FakeMisa.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../profiles/*.json" Link="profiles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
