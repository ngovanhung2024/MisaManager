<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fake "MISA SME 2023 R20" for integration tests. The exe is MISA.SME.exe so the real
       window discovery accepts it; control IDs are read from profiles/*.json at runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MISA.SME</AssemblyName>
    <RootNamespace>MisaManager.FakeMisa</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <!-- WinForms is only used for the module toolbar; keep WPF types unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../profiles/*.json" Link="profiles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
