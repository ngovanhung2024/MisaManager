<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Primary" Color="#2563EB"/>
  <SolidColorBrush x:Key="PrimarySoft" Color="#EFF4FF"/>
  <SolidColorBrush x:Key="Success" Color="#15803D"/>
  <SolidColorBrush x:Key="SuccessSoft" Color="#ECFDF3"/>
  <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
  <SolidColorBrush x:Key="DangerSoft" Color="#FEF2F2"/>
  <SolidColorBrush x:Key="DangerStrong" Color="#FEE2E2"/>
  <SolidColorBrush x:Key="Warn" Color="#B45309"/>
  <SolidColorBrush x:Key="WarnSoft" Color="#FFFBEB"/>
  <SolidColorBrush x:Key="Line" Color="#E4E8EF"/>
  <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
  <SolidColorBrush x:Key="Faint" Color="#9CA3AF"/>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="6,4"/>
  </Style>

  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="9.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Faint}"/>
  </Style>

  <!-- Compact button: hover darkens through an overlay, press shrinks slightly. -->
  <Style x:Key="RailButton" TargetType="Button">
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="#1F2937"/>
    <Setter Property="BorderBrush" Value="#D6DBE4"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Overlay" Background="Black" Opacity="0" CornerRadius="5" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.12"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.05"/>
                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.06"/>
                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.06"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.1"/>
                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.42"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
    <Setter Property="Background" Value="{StaticResource Primary}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="MinHeight" Value="26"/>
  </Style>
  <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
    <Setter Property="Background" Value="#FEF3C7"/>
    <Setter Property="Foreground" Value="#92400E"/>
    <Setter Property="BorderBrush" Value="#FCD34D"/>
    <Setter Property="MinHeight" Value="26"/>
  </Style>
  <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
    <Setter Property="Background" Value="#DCFCE7"/>
    <Setter Property="Foreground" Value="#166534"/>
    <Setter Property="BorderBrush" Value="#86EFAC"/>
    <Setter Property="MinHeight" Value="26"/>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource RailButton}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="26"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="ToggleChip" TargetType="ToggleButton">
    <Setter Property="Padding" Value="7,1"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#4B5563"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Surface" Background="#F3F4F6" BorderBrush="#D6DBE4" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9CA3AF"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{StaticResource DangerStrong}"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Danger}"/>
              <Setter Property="Foreground" Value="#991B1B"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Shared Excel-vs-MISA row (comparison window and profile tab): green when matched, red when mismatched. -->
  <DataTemplate x:Key="ComparisonRowTemplate">
    <Border x:Name="RowBorder" Padding="6,3,6,3" Margin="0,0,0,1" BorderThickness="3,0,0,0" BorderBrush="#D1D5DB" Background="#F3F4F6" ToolTip="{Binding Evidence}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="76"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="22"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LabelText" Text="{Binding ShortLabel}" ToolTip="{Binding Value.Field}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,6,0"/>
        <Border x:Name="ExpectedCell" Grid.Column="1" Margin="0,0,3,0" Padding="4,2" CornerRadius="3" Background="#B3FFFFFF" ToolTip="{Binding ExpectedText}">
          <TextBlock x:Name="ExpectedText" Text="{Binding ExpectedValue}" FontSize="11" TextWrapping="Wrap" Foreground="#111827"/>
        </Border>
        <Border x:Name="ActualCell" Grid.Column="2" Padding="4,2" CornerRadius="3" Background="#B3FFFFFF" ToolTip="{Binding ActualText}">
          <TextBlock x:Name="ActualText" Text="{Binding ActualValue}" FontSize="11" TextWrapping="Wrap" Foreground="#111827"/>
        </Border>
        <TextBlock x:Name="MarkText" Grid.Column="3" Text="{Binding ResultIcon}" ToolTip="{Binding ResultTip}" FontSize="13" FontWeight="Bold" Foreground="#9CA3AF"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"/>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="pending">
        <Setter TargetName="ActualText" Property="Foreground" Value="#9CA3AF"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="match">
        <Setter TargetName="RowBorder" Property="Background" Value="#DCFCE7"/>
        <Setter TargetName="RowBorder" Property="BorderBrush" Value="#15803D"/>
        <Setter TargetName="LabelText" Property="Foreground" Value="#15803D"/>
        <Setter TargetName="ExpectedText" Property="Foreground" Value="#166534"/>
        <Setter TargetName="ActualText" Property="Foreground" Value="#166534"/>
        <Setter TargetName="MarkText" Property="Foreground" Value="#15803D"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="mismatch">
        <Setter TargetName="RowBorder" Property="Background" Value="#FEE2E2"/>
        <Setter TargetName="RowBorder" Property="BorderBrush" Value="#B91C1C"/>
        <Setter TargetName="LabelText" Property="Foreground" Value="#B91C1C"/>
        <Setter TargetName="ExpectedText" Property="Foreground" Value="#7F1D1D"/>
        <Setter TargetName="ActualText" Property="FontWeight" Value="Bold"/>
        <Setter TargetName="ActualText" Property="Foreground" Value="#B91C1C"/>
        <Setter TargetName="MarkText" Property="Foreground" Value="#B91C1C"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
