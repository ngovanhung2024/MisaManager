<Window x:Class="MisaManager.App.ComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:MisaManager.App"
        Title="Đối chiếu MISA" Width="366" MinWidth="302" MaxWidth="479" MinHeight="520"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" WindowStyle="SingleBorderWindow"
        ResizeMode="CanMinimize" Background="#F4F6FA"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11.5" Foreground="#111827"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <DataTemplate x:Key="SectionTemplate">
      <StackPanel Margin="0,0,0,5">
        <Border x:Name="SectionHeader" Background="#EEF1F6" Padding="6,2" BorderThickness="3,0,0,0" BorderBrush="#9CA3AF">
          <DockPanel>
            <TextBlock x:Name="SectionBadge" DockPanel.Dock="Right" Text="{Binding Badge}" FontSize="9.5" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Foreground="#1F2937"/>
          </DockPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ComparisonRowTemplate}"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasMismatch}" Value="True">
          <Setter TargetName="SectionHeader" Property="Background" Value="#FECACA"/>
          <Setter TargetName="SectionHeader" Property="BorderBrush" Value="#DC2626"/>
          <Setter TargetName="SectionBadge" Property="Foreground" Value="#991B1B"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding AllMatched}" Value="True">
          <Setter TargetName="SectionBadge" Property="Foreground" Value="#15803D"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="Root" Margin="6,5,6,5">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Style="{StaticResource Card}" Padding="8,5">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" x:Name="ReconcileButton" Content="Đọc lại" Style="{StaticResource RailButton}"
                  Click="ReconcileButton_Click" Margin="6,0,0,0" ToolTip="Đọc lại dữ liệu MISA và đối chiếu lại"/>
          <StackPanel>
            <TextBlock x:Name="TitleLabel" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubtitleLabel" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
        <Border x:Name="StatusChip" CornerRadius="5" Padding="7,3" Margin="0,5,0,0">
          <DockPanel>
            <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="StatusLabel" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
            <TextBlock x:Name="ObservedLabel" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <TextBlock x:Name="SummaryLabel" FontSize="10.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="30"/>
        <DockPanel Margin="0,5,0,0">
          <ToggleButton x:Name="OnlyMismatchToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleChip}" Content="Chỉ hiện dòng lệch"
                        Checked="OnlyMismatch_Changed" Unchecked="OnlyMismatch_Changed" ToolTip="Ẩn các dòng đã khớp để thấy ngay chỗ sai"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="MatchCount" Text="0" FontWeight="Bold" Foreground="{StaticResource Success}"/>
            <TextBlock Text=" khớp   " FontSize="10.5" Foreground="{StaticResource Success}"/>
            <TextBlock x:Name="MismatchCount" Text="0" FontWeight="Bold" Foreground="{StaticResource Danger}"/>
            <TextBlock Text=" lệch   " FontSize="10.5" Foreground="{StaticResource Danger}"/>
            <TextBlock x:Name="PendingCount" Text="0" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
            <TextBlock Text=" chưa đọc" FontSize="10.5" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="3,6,3,2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="TRƯỜNG" Style="{StaticResource Caption}"/>
      <TextBlock Grid.Column="1" Text="NGUỒN EXCEL (mong đợi)" Style="{StaticResource Caption}"/>
      <TextBlock Grid.Column="2" Text="MISA (đọc được)" Style="{StaticResource Caption}"/>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <ScrollViewer x:Name="RowsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,2">
          <ItemsControl x:Name="SectionList" ItemTemplate="{StaticResource SectionTemplate}"/>
        </ScrollViewer>
        <TextBlock x:Name="EmptyLabel" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}"
                   VerticalAlignment="Top" Margin="16,28,16,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
